"""
Oil-production-management - File di esclusione Git

Questo file definisce le cartelle e i file che non devono essere 
tracciati dal controllo versione per mantenere il repository pulito.
"""

# =============================================================================
# DIPENDENZE E AMBIENTE
# =============================================================================
.venv/
venv/
env/
__pycache__/
*.py[cod]

# =============================================================================
# CONFIGURAZIONE E DATI LOCALI
# =============================================================================
.vscode/          # Impostazioni IDE
.env              # File di configurazione sensibile (credenziali)
instance/         # Database locale e file di sessione
*.db              # Database SQLite locale
*.sqlite3         # Database SQLite locale

# =============================================================================
# SISTEMA OPERATIVO
# =============================================================================
.DS_Store         # File di sistema macOS
Thumbs.db         # File di sistema Windows

